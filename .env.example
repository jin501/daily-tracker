# Postgres connection string (Supabase, Neon, or Vercel Postgres all work)
DATABASE_URL=postgres://user:pass@host:5432/db

# Claude API key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional, defaults to Haiku (cheap + fast is plenty for parsing)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# USDA FoodData Central key (free): https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for testing but is heavily rate limited
USDA_API_KEY=DEMO_KEY

# Single-user login
APP_PASSWORD=pick-something
SESSION_SECRET=any-long-random-string

# Your timezone, and the hour your "day" rolls over (3 = 3am, so late snacks count for the day before)
APP_TIMEZONE=America/New_York
DAY_START_HOUR=3
